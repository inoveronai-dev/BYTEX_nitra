# Persistent SQLite database path (absolute path recommended in production)
DATABASE_PATH=./data/bytex.db

# Persistent uploads directory
UPLOAD_DIR=./data/uploads

# Long random secret used to sign session cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL (used for Origin checks / absolute links)
APP_URL=http://localhost:3000

# Set to true behind HTTPS in production
COOKIE_SECURE=false

NODE_ENV=development

# Public site URL (Origin / CSRF checks)
APP_URL=http://localhost:3000

# Long random secret used to sign session cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true behind HTTPS in production
COOKIE_SECURE=false

NODE_ENV=development

# Stateless admin auth (no database)
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash-password
# Escape $ as \$ in .env files (dotenv expands $vars), e.g. \$2b\$12\$...
ADMIN_PASSWORD_HASH=

# GitHub CMS (Contents read/write fine-grained PAT)
GITHUB_OWNER=inoveronai-dev
GITHUB_REPO=BYTEX_nitra
GITHUB_BRANCH=cms-github-test
GITHUB_CONTENT_TOKEN=

# Vercel Web Analytics (admin dashboard only — server-side)
# Create a token: Vercel → Account Settings → Tokens (scope: read analytics / full access)
VERCEL_TOKEN=
# Project ID from Vercel project settings (also auto-set on Vercel deployments)
VERCEL_PROJECT_ID=
# Team ID if the project belongs to a team (e.g. team_…)
VERCEL_TEAM_ID=
